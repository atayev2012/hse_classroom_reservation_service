# Application ports
FRONTEND_PORT=5173
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=5534
NOTIFICATION_SERVICE_PORT=5533
BOOKING_SERVICE_PORT=5535
SCHEDULE_SERVICE_PORT=5536

# Databases
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=change-me
AUTH_DB_PORT=5434

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USERNAME=notification_user
NOTIFICATION_DB_PASSWORD=change-me
NOTIFICATION_DB_PORT=5433

BOOKING_DB_NAME=booking_db
BOOKING_DB_USERNAME=booking_user
BOOKING_DB_PASSWORD=change-me
BOOKING_DB_PORT=5435

SCHEDULE_DB_NAME=schedule_db
SCHEDULE_DB_USERNAME=schedule_user
SCHEDULE_DB_PASSWORD=change-me
SCHEDULE_DB_PORT=5436

# Auth and cookies
AUTH_JWT_SECRET_KEY=change-me
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ACCESS_EXPIRE_MINUTES=15
AUTH_JWT_REFRESH_EXPIRE_DAYS=30
AUTH_VERIFICATION_URL=http://localhost:5173/verify
AUTH_VERIFICATION_CODE_VALID_MINUTES=10
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Gateway and frontend
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=/api/v1

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=notification@example.com
EMAIL_PASSWORD=change-me
EMAIL_ADDRESS=notification@example.com
EMAIL_FROM_NAME=HSE Booking
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=15
